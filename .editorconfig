root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 100

[*.{nut,tcl}]
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
max_line_length = 81
trim_trailing_whitespace = false

[*.{cfg,ini,flake8}]
indent_size = 4
